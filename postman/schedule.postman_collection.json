              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('dayOfWeek is 1', () => pm.expect(json.data.dayOfWeek).to.equal(1));",
                  "pm.test('isWorking is true', () => pm.expect(json.data.isWorking).to.be.true);",
                  "pm.test('regularStartTime is 09:00', () => pm.expect(json.data.regularStartTime).to.equal('09:00'));",
                  "pm.test('regularEndTime is 17:00', () => pm.expect(json.data.regularEndTime).to.equal('17:00'));",
                  "pm.test('slotDurationMinutes is 30', () => pm.expect(json.data.slotDurationMinutes).to.equal(30));",
                  "pm.test('updatedAt is fresh', () => {",
                  "  const updated = new Date(json.data.updatedAt).getTime();",
                  "  pm.expect(updated).to.be.closeTo(Date.now(), 5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
