        {
          "name": "[PAUSE] Verify bookings in pause range were cancelled",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const rb = json.recurringBooking;",
                  "const pauseStart = pm.collectionVariables.get('pauseStart');",
                  "const pauseEnd = pm.collectionVariables.get('pauseEnd');",
                  "const within = rb.upcomingOccurrences.filter(o => {",
                  "  const d = o.scheduledAt.split('T')[0];",
                  "  return d >= pauseStart && d <= pauseEnd;",
                  "});",
                  "pm.test('no upcoming occurrences remain inside pause window', () => pm.expect(within).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
