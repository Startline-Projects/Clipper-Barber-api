{
  "info": {
    "name": "Barber Services API",
    "_postman_id": "barber-services-collection",
    "description": "Full test suite for the Barber Services CRUD endpoints.\n\n## Setup\n1. Run the **[AUTH] Login as Barber** request first — it auto-sets `{{token}}` and `{{barberId}}` via the test script.\n2. All subsequent requests use those variables automatically.\n\n## Variables used\n| Variable | Set by |\n|---|---|\n| `baseUrl` | Collection variable (default: http://localhost:3001) |\n| `token` | Auto-set after login |\n| `barberId` | Auto-set after login |\n| `serviceId` | Auto-set after the first Create request |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "barberId", "value": "" },
    { "key": "serviceId", "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "[AUTH] Login as Barber",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "}",
                  "if (json.barber?.id) {",
                  "  pm.collectionVariables.set('barberId', json.barber.id);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.test('barberId captured', () => pm.expect(pm.collectionVariables.get('barberId')).to.not.be.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"barber@example.com\",\n  \"password\": \"YourPassword123!\",\n  \"role\": \"barber\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "✅ Happy Path",
      "item": [
        {
          "name": "1. Create Service — Haircut",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('Has service id', () => pm.expect(json.data.id).to.be.a('string'));",
                  "pm.test('name matches', () => pm.expect(json.data.name).to.eql('Skin Fade'));",
                  "pm.test('serviceType = haircut', () => pm.expect(json.data.serviceType).to.eql('haircut'));",
                  "pm.test('durationMinutes = 30', () => pm.expect(json.data.durationMinutes).to.eql(30));",
                  "pm.test('regularPriceUsd = 35', () => pm.expect(json.data.regularPriceUsd).to.eql(35));",
                  "pm.test('isActive = true', () => pm.expect(json.data.isActive).to.be.true);",
                  "pm.test('sortOrder = 0 (first service)', () => pm.expect(json.data.sortOrder).to.eql(0));",
                  "// Save for later requests",
                  "pm.collectionVariables.set('serviceId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Skin Fade\",\n  \"serviceType\": \"haircut\",\n  \"durationMinutes\": 30,\n  \"regularPriceUsd\": 35,\n  \"afterHoursPriceUsd\": 45,\n  \"dayOffPriceUsd\": 55\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/barbers/{{barberId}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["barbers", "{{barberId}}", "services"]
            }
          }
        },
        {
          "name": "2. Create Service — Beard Trim (no after-hours prices)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('afterHoursPriceUsd = null', () => pm.expect(json.data.afterHoursPriceUsd).to.be.null);",
                  "pm.test('dayOffPriceUsd = null', () => pm.expect(json.data.dayOffPriceUsd).to.be.null);",
                  "pm.test('sortOrder = 1 (second service)', () => pm.expect(json.data.sortOrder).to.eql(1));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beard Trim\",\n  \"serviceType\": \"beard\",\n  \"durationMinutes\": 15,\n  \"regularPriceUsd\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/barbers/{{barberId}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["barbers", "{{barberId}}", "services"]
            }
          }
        },
        {
          "name": "3. List All Services (incl. inactive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success = true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('data is array', () => pm.expect(json.data).to.be.an('array'));",
                  "pm.test('At least 2 services', () => pm.expect(json.data.length).to.be.gte(2));",
                  "pm.test('Ordered by sort_order ASC', () => {",
                  "  const orders = json.data.map(s => s.sortOrder);",
                  "  const sorted = [...orders].sort((a, b) => a - b);",
                  "  pm.expect(orders).to.eql(sorted);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/barbers/{{barberId}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["barbers", "{{barberId}}", "services"]
            }
          }
        },
