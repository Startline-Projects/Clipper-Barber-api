    {
      "name": "4. Preview",
      "item": [
        {
          "name": "[PREVIEW] 1 service regular — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json().preview;",
                  "pm.test('services[] length 1', () => pm.expect(json.services).to.have.lengthOf(1));",
                  "pm.test('startOffsetMinutes = 0 on first service', () => pm.expect(json.services[0].startOffsetMinutes).to.equal(0));",
                  "pm.test('totalDurationMinutes equals service duration', () => pm.expect(json.totalDurationMinutes).to.equal(json.services[0].durationMinutes));",
                  "pm.test('pricing.totalPrice equals service pricing.totalPrice', () => pm.expect(json.pricing.totalPrice).to.be.closeTo(json.services[0].pricing.totalPrice, 0.01));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"services\": [\n    { \"barberServiceId\": \"{{serviceAId}}\", \"bookingType\": \"regular\" }\n  ],\n  \"date\": \"{{bookingDate}}\",\n  \"slotTime\": \"{{slotTime}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/preview",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "preview"]
            }
          }
        },
        {
          "name": "[PREVIEW] 2 services regular — sum prices + durations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json().preview;",
                  "pm.test('services[] length 2', () => pm.expect(json.services).to.have.lengthOf(2));",
                  "const a = json.services[0], b = json.services[1];",
                  "pm.test('first startOffsetMinutes = 0', () => pm.expect(a.startOffsetMinutes).to.equal(0));",
                  "pm.test('second startOffsetMinutes = first duration', () => pm.expect(b.startOffsetMinutes).to.equal(a.durationMinutes));",
                  "pm.test('totalDurationMinutes = sum of durations', () => pm.expect(json.totalDurationMinutes).to.equal(a.durationMinutes + b.durationMinutes));",
                  "pm.test('pricing.totalPrice = sum of per-service totals', () => pm.expect(json.pricing.totalPrice).to.be.closeTo(a.pricing.totalPrice + b.pricing.totalPrice, 0.01));",
                  "pm.test('each service priced under its own bookingType', () => {",
                  "  pm.expect(a.bookingType).to.equal('regular');",
                  "  pm.expect(b.bookingType).to.equal('regular');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"services\": [\n    { \"barberServiceId\": \"{{serviceAId}}\", \"bookingType\": \"regular\" },\n    { \"barberServiceId\": \"{{serviceBId}}\", \"bookingType\": \"regular\" }\n  ],\n  \"date\": \"{{bookingDate}}\",\n  \"slotTime\": \"{{slotTime}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/preview",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "preview"]
            }
          }
        },
