                "exec": [
                  "if (!pm.collectionVariables.get('serviceAfterHoursId')) {",
                  "  console.log('Skipping boundary-crossing preview — serviceAfterHoursId is not set.');",
                  "  postman.setNextRequest(null);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json().preview;",
                  "pm.test('services[] length 2', () => pm.expect(json.services).to.have.lengthOf(2));",
                  "pm.test('first bookingType is regular', () => pm.expect(json.services[0].bookingType).to.equal('regular'));",
                  "pm.test('second bookingType is after_hours', () => pm.expect(json.services[1].bookingType).to.equal('after_hours'));",
                  "pm.test('second service priced at its after_hours rate', () => pm.expect(json.services[1].pricing.totalPrice).to.be.greaterThanOrEqual(json.services[1].pricing.basePrice));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"services\": [\n    { \"barberServiceId\": \"{{serviceAId}}\", \"bookingType\": \"regular\" },\n    { \"barberServiceId\": \"{{serviceAfterHoursId}}\", \"bookingType\": \"after_hours\" }\n  ],\n  \"date\": \"{{bookingDate}}\",\n  \"slotTime\": \"{{boundarySlotTime}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/preview",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "preview"]
            }
          }
        },
        {
          "name": "[PREVIEW] after_hours service inside regular-only window — 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"services\": [\n    { \"barberServiceId\": \"{{serviceAId}}\", \"bookingType\": \"after_hours\" }\n  ],\n  \"date\": \"{{bookingDate}}\",\n  \"slotTime\": \"{{slotTime}}\"\n}"
