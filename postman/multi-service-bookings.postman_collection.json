        {
          "name": "[CONFIRM] overlap inside multi-slot block — 409",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compute slotTime + slotDurationMinutes (assumes 30-min grid). The first",
                  "// service of a 2-service block covers [slotTime, slotTime+30) — so a fresh",
                  "// 1-service booking at slotTime+30 must overlap with the second half of",
                  "// the block created by 'CONFIRM happy path'.",
                  "const [h, m] = pm.collectionVariables.get('slotTime').split(':').map(Number);",
                  "const total = h * 60 + m + 30;",
                  "const nh = String(Math.floor(total / 60)).padStart(2, '0');",
                  "const nm = String(total % 60).padStart(2, '0');",
                  "pm.variables.set('overlapSlotTime', `${nh}:${nm}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 409', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"services\": [\n    { \"barberServiceId\": \"{{serviceAId}}\", \"bookingType\": \"regular\" }\n  ],\n  \"date\": \"{{bookingDate}}\",\n  \"slotTime\": \"{{overlapSlotTime}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "confirm"]
            }
          }
        }
