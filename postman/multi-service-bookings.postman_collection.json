                  "pm.test('totalDurationMinutes = sum', () => pm.expect(json.totalDurationMinutes).to.equal(json.services[0].durationMinutes + json.services[1].durationMinutes));",
                  "pm.test('pricing.totalPrice = sum of per-service totals', () => pm.expect(json.pricing.totalPrice).to.be.closeTo(json.services[0].pricing.totalPrice + json.services[1].pricing.totalPrice, 0.01));"
