    {
      "name": "6. Client Booking Detail",
      "item": [
        {
          "name": "[DETAIL] returns services[] with per-service pricing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json().booking;",
                  "pm.test('services[] length 2', () => pm.expect(json.services).to.have.lengthOf(2));",
                  "pm.test('each service has pricing + startOffsetMinutes', () => {",
                  "  json.services.forEach(s => {",
                  "    pm.expect(s.pricing).to.have.all.keys('basePrice', 'additionalCost', 'totalPrice');",
                  "    pm.expect(s).to.have.property('startOffsetMinutes');",
                  "    pm.expect(s).to.have.property('bookingType');",
                  "  });",
                  "});",
                  "pm.test('services are sorted by startOffsetMinutes', () => {",
                  "  for (let i = 1; i < json.services.length; i++) {",
                  "    pm.expect(json.services[i].startOffsetMinutes).to.be.greaterThan(json.services[i-1].startOffsetMinutes);",
                  "  }",
                  "});",
                  "pm.test('totalPrice = sum of per-service totals', () => {",
                  "  const sum = json.services.reduce((a, s) => a + s.pricing.totalPrice, 0);",
                  "  pm.expect(json.totalPrice).to.be.closeTo(sum, 0.01);",
                  "});",
                  "pm.test('totalDurationMinutes = sum of durations', () => {",
                  "  const sum = json.services.reduce((a, s) => a + s.durationMinutes, 0);",
                  "  pm.expect(json.totalDurationMinutes).to.equal(sum);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/client/bookings/{{createdBookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["client", "bookings", "{{createdBookingId}}"]
            }
          }
        }
