PORT=3001
NODE_ENV=development


### Supabase
# From the Supabase project's API settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=


## Stripe API keys
# From the Stripe dashboard. Use test-mode keys (sk_test_…) for non-prod.
# StripeService.constructor() reads these via getOrThrow — the app fails to
# boot if any are missing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Two recurring prices on a single product (Barbershop Client Subscription).
# Monthly $0.99, yearly $9.99 per spec.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Required for env validation; not actually referenced — Express Connect
# accounts use accounts.del/accountLinks, not the OAuth client_id.
STRIPE_CONNECT_CLIENT_ID=

# Used as the base for Connect onboarding return / refresh URLs.
APP_URL_CLIENT=http://localhost:4200
APP_URL_BARBER=http://localhost:3000


## Push notifications
EXPO_ACCESS_TOKEN=
